# Copy to .env and fill in the providers you want. All are optional:
# the recommender works without any key; the AI concierge uses the first provider that is configured.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
PORT=3001
